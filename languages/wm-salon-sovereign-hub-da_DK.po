msgstr ""
"Slet plugin-indstillinger og hastighedsbegrænsnings-transients ved "
"afinstallation."

#: includes/class-salon-integrations.php:62
msgid "WM Salon Sovereign Hub — Deinstallation"
msgstr "WM Salon Sovereign Hub — Afinstallation"

