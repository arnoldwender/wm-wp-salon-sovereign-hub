#. Plugin Name of the plugin
#: wm-salon-sovereign-hub.php
msgid "WM Salon Sovereign Hub"
msgstr "WM Salon Sovereign Hub"

#. Plugin URI of the plugin
#: wm-salon-sovereign-hub.php
msgid "https://arnoldwender.com/wordpress-plugins/wm-salon-sovereign-hub/"
msgstr ""

#. Description of the plugin
#: wm-salon-sovereign-hub.php
msgid ""
"Zwei Rechner für Friseursalons: Umsatzaufteilung bei Stuhlmiete (Salon / "
"selbstständiger Stylist) und lokaler INCI-Inhaltsstoff-Prüfer, als "
"Shortcode, REST-Route und WP-CLI-Befehl."
msgstr ""
"Dhá áireamhán do thragóirí gruaige: roinnt ioncaim cíosa cathaoireach "
"(salón / stíleoir neamhspleách) agus seiceálaí áitiúil comhábhar INCI mar "
"ghearrchód, bealach REST agus ordú WP-CLI."

#. Author of the plugin
#: wm-salon-sovereign-hub.php
msgid "Arnold Wender"
msgstr "Arnold Wender"

#. Author URI of the plugin
#: wm-salon-sovereign-hub.php
msgid "https://arnoldwender.com"
msgstr ""

#: includes/class-salon-integrations.php:51
msgid "Plugin-Optionen und Rate-Limit-Transients beim Deinstallieren löschen."
msgstr ""
"Scrios roghanna an bhreiseáin agus sonraí sealadacha teorann ráta le linn "
"díshuiteála."

#: includes/class-salon-integrations.php:62
msgid "WM Salon Sovereign Hub — Deinstallation"
msgstr "WM Salon Sovereign Hub — Díshuiteáil"

#: includes/class-salon-integrations.php:77
msgid ""
"Optionen und Rate-Limit-Transients beim Deinstallieren des Plugins endgültig "
"löschen (standardmäßig deaktiviert)."
msgstr ""
"Scrios roghanna agus sonraí sealadacha teorann ráta go buan nuair a "
"dhíshuiteáiltear an breiseán (díchumasaithe de réir réamhshocraithe)."

#: includes/class-salon-integrations.php:95
msgid "WM Salon Kennzahlen"
msgstr "Méadrachtaí WM Salon"

#: includes/class-salon-integrations.php:130
msgid "WM Salon Kennzahl"
msgstr "Méadracht WM Salon"

#: includes/class-salon-integrations.php:137
msgid "Kennzahl-Schlüssel"
msgstr "Eochair mhéadrachta"

#: includes/class-salon-integrations.php:141
msgid "Bruttoumsatz (€)"
msgstr "ollioncam (€)"

#: includes/class-salon-integrations.php:145
msgid "Salon-Anteil (0–1)"
msgstr "Scair an tsalóin (0–1)"

#: includes/class-salon-integrations.php:149
msgid "Feste Miete (€)"
msgstr "Cíos seasta (€)"

#: includes/class-salon-rest-controller.php:51
#: includes/class-salon-rest-controller.php:65
msgid "Zu viele Anfragen. Bitte in einer Minute erneut versuchen."
msgstr "An iomarca iarratas. Bain triail eile as i gceann nóiméid."

#. translators: %s: parameter name.
#: includes/class-salon-rest-controller.php:152
#, php-format
msgid "%s fehlt."
msgstr "Tá %s ar iarraidh."

#. translators: 1: parameter name, 2: minimum, 3: maximum.
#: includes/class-salon-rest-controller.php:165
#, php-format
msgid "%1$s muss eine Zahl zwischen %2$s und %3$s sein."
msgstr "Caithfidh %1$s a bheith ina uimhir idir %2$s agus %3$s."

#: includes/class-salon-rest-controller.php:175
msgid "Die Beträge können nicht berechnet werden."
msgstr "Ní féidir na suimeanna a ríomh."

#: includes/class-salon-rest-controller.php:198
msgid "inci muss ein Text sein."
msgstr "Caithfidh inci a bheith ina theaghrán téacs."

#: includes/class-salon-rest-controller.php:201
msgid "Die Inhaltsstoffliste überschreitet die zulässige Länge."
msgstr "Sáraíonn liosta na gcomhábhar an fad uasta ceadaithe."

#: includes/class-salon-rest-controller.php:207
msgid "Die Liste enthält keinen Inhaltsstoff."
msgstr "Níl aon chomhábhar sa liosta."

#: includes/class-salon-shortcodes.php:82
#: includes/class-salon-shortcodes.php:83
msgid "Stuhlmiete-Rechner"
msgstr "Áireamhán Cíosa Cathaoireach"

#: includes/class-salon-shortcodes.php:84
msgid ""
"Berechnet die Umsatzaufteilung zwischen Saloninhaber und selbstständigem "
"Stylisten. Der Rechner prüft nicht, ob die Stuhlmiete "
"sozialversicherungsrechtlich als Selbstständigkeit gilt."
msgstr ""
"Ríomhann sé roinnt an ioncaim idir úinéir an tsalóin agus an stíleoir "
"neamhspleách. Ní dhéanann an t-áireamhán measúnú ar cibé an ionann an cíos "
"cathaoireach agus féinfhostaíocht faoin dlí leasa shóisialaigh."

#: includes/class-salon-shortcodes.php:86
msgid "Bruttoumsatz des Stylisten (€ inkl. MwSt.)"
msgstr "Ollioncam an stíleora (€ CBL san áireamh)"

#: includes/class-salon-shortcodes.php:87
msgid "Umsatzbeteiligung Salon (%)"
msgstr "Scair ioncaim an tsalóin (%)"

#: includes/class-salon-shortcodes.php:88
msgid "Feste Stuhlmiete im selben Zeitraum (€)"
msgstr "Cíos cathaoireach seasta sa tréimhse chéanna (€)"

#: includes/class-salon-shortcodes.php:89
msgid "Aufteilung berechnen"
msgstr "Ríomh an roinnt"

#: includes/class-salon-shortcodes.php:102
msgid "Ergebnis"
msgstr "Toradh"

#: includes/class-salon-shortcodes.php:104
msgid ""
"Bitte gültige Beträge und eine Beteiligung zwischen 0 und 100 % eingeben."
msgstr "Cuir isteach suimeanna bailí agus scair idir 0 agus 100%."

#: includes/class-salon-shortcodes.php:106
msgid "Abrechnungsergebnis"
msgstr "Toradh an tsocraithe"

#: includes/class-salon-shortcodes.php:108
msgid "Salon-Anteil (brutto)"
msgstr "Scair an tsalóin (oll)"

#: includes/class-salon-shortcodes.php:109
msgid "Auszahlung Stylist (brutto)"
msgstr "Íocaíocht an stíleora (oll)"

#: includes/class-salon-shortcodes.php:110
msgid "Enthaltene MwSt. (19 %)"
msgstr "CBL san áireamh (19%)"

#: includes/class-salon-shortcodes.php:111
msgid "Netto-Umsatz"
msgstr "Glanioncam"

#. translators: %s: amount in euros.
#: includes/class-salon-shortcodes.php:117
#, php-format
msgid ""
"Der Salon-Anteil übersteigt den Umsatz um %s; die Auszahlung an den "
"Stylisten ist 0."
msgstr ""
"Sáraíonn scair an tsalóin an t-ioncam faoi %s; is é 0 íocaíocht an stíleora."

#: includes/class-salon-shortcodes.php:142
msgid "INCI-Prüfer"
msgstr "Seiceálaí INCI"

#: includes/class-salon-shortcodes.php:143
msgid "Lokaler INCI-Inhaltsstoff-Prüfer"
msgstr "Seiceálaí Áitiúil Comhábhar INCI"

#: includes/class-salon-shortcodes.php:144
msgid ""
"Prüft eine Inhaltsstoffliste auf dieser Website, ohne externe Anfrage, gegen "
"eine feste Stoffliste: 5 Sulfate, 6 Silikone, 5 Parabene und 8 Duftstoff-"
"Allergene (u. a. Limonene, Linalool, Citral). Stoffe außerhalb dieser Liste "
"werden nicht erkannt; ob und ab welcher Konzentration ein Stoff zu "
"deklarieren ist, prüft der Rechner nicht."
msgstr ""
"Seiceálann sé liosta comhábhar go háitiúil ar an suíomh seo gan iarratas "
"seachtrach i gcoinne liosta sheasta: 5 shulfáit, 6 shileacón, 5 pharaibín "
"agus 8 n-ailléirgin cumhráin (Limonene, Linalool, Citral san áireamh). Ní "
"aithnítear substaintí lasmuigh den liosta seo."

#: includes/class-salon-shortcodes.php:146
msgid "INCI-Inhaltsstoffe (durch Komma, Semikolon oder Zeilenumbruch getrennt)"
msgstr "Comhábhair INCI (scartha le camóg, leathstad nó briseadh líne)"

#: includes/class-salon-shortcodes.php:147
msgid "INCI analysieren"
msgstr "Déan anailís ar INCI"

#: includes/class-salon-shortcodes.php:152
msgid "INCI-Ergebnis"
msgstr "Toradh INCI"

#: includes/class-salon-shortcodes.php:154
msgid "Die Liste enthält keinen Inhaltsstoff; es gibt kein Ergebnis."
msgstr "Níl aon chomhábhar sa liosta; níl aon toradh ann."

#. translators: %d: number of ingredients recognised in the list.
#: includes/class-salon-shortcodes.php:160
#, php-format
msgid "%d Inhaltsstoff erkannt"
msgid_plural "%d Inhaltsstoffe erkannt"
msgstr[0] "%d chomhábhar aitheanta"
msgstr[1] "%d chomhábhar aitheanta"
msgstr[2] "%d chomhábhar aitheanta"
msgstr[3] "%d gcomhábhar aitheanta"
msgstr[4] "%d comhábhar aitheanta"

#: includes/class-salon-shortcodes.php:164
msgid "Clean-Score"
msgstr "Scór Glan"

#. translators: %s: comma-separated allergen names.
#: includes/class-salon-shortcodes.php:174
#, php-format
msgid "Duftstoff-Allergene aus der Liste: %s"
msgstr "Ailléirginí cumhráin ón liosta: %s"

#. translators: %s: action name.
#: includes/class-salon-spoke-adapter.php:130
#, php-format
msgid "Unbekannte Spoke-Aktion \"%s\"."
msgstr "Gníomh anaithnid modúil \"%s\"."

#: includes/class-salon-spoke-adapter.php:154
msgid "Stuhlmiete-Rechner und INCI-Prüfer liefern die erwarteten Werte."
msgstr ""
"Tugann an t-áireamhán cíosa cathaoireach agus an seiceálaí INCI na luachanna "
"a rabhthas ag súil leo."

#: includes/class-salon-spoke-adapter.php:155
msgid "Selbsttest fehlgeschlagen: ein Rechner liefert abweichende Werte."
msgstr "Theip ar an bhféintástáil: thug áireamhán luachanna éagsúla ar ais."

