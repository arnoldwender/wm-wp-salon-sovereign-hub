#. Plugin Name of the plugin
#: wm-salon-sovereign-hub.php
msgid "WM Salon Sovereign Hub"
msgstr "WM Salon Sovereign Hub"

#. Plugin URI of the plugin
#: wm-salon-sovereign-hub.php
msgid "https://arnoldwender.com/wordpress-plugins/wm-salon-sovereign-hub/"
msgstr ""

#. Description of the plugin
#: wm-salon-sovereign-hub.php
msgid ""
"Zwei Rechner für Friseursalons: Umsatzaufteilung bei Stuhlmiete (Salon / "
"selbstständiger Stylist) und lokaler INCI-Inhaltsstoff-Prüfer, als "
"Shortcode, REST-Route und WP-CLI-Befehl."
msgstr ""
"Kaks kalkulaatorit juuksurisalongidele: toolirendi käibejaotus (salong / "
"sõltumatu stilist) ja kohalik INCI koostisosade kontrollija lühikoodi, REST-"
"marsruudi ja WP-CLI käsuna."

#. Author of the plugin
#: wm-salon-sovereign-hub.php
msgid "Arnold Wender"
msgstr "Arnold Wender"

#. Author URI of the plugin
#: wm-salon-sovereign-hub.php
msgid "https://arnoldwender.com"
msgstr ""

